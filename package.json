{
  "name": "vak",
  "version": "0.1.0",
  "description": "VAK - a glass dynamic island for Windows: AI chat, clock, file shelf, converter, and more, always one hover away.",
  "main": "electron/main.js",
  "author": "Kartik Pagariya",
  "license": "MIT",
  "scripts": {
    "start": "node node_modules/electron/cli.js .",
    "dev": "node node_modules/electron/cli.js . --dev"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "dependencies": {
    "sharp": "^0.33.5",
    "archiver": "^7.0.1"
  },
  "build": {
    "appId": "dev.kartik.vak",
    "productName": "VAK",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}