{
  "name": "isla",
  "version": "0.1.0",
  "description": "A glass dynamic island for Windows - AI chat, clock, file shelf, and a file converter, always one hover away.",
  "main": "electron/main.js",
  "author": "Kartik Pagariya",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "dependencies": {
    "sharp": "^0.33.5",
    "archiver": "^7.0.1",
    "get-windows-accent-color": "^2.0.0"
  },
  "build": {
    "appId": "dev.kartik.isla",
    "productName": "Isla",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  }
}
