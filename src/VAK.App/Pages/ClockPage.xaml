<UserControl x:Class="VAK.App.Pages.ClockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VAK.App.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Clock settings card -->
        <Border Style="{StaticResource Style.Card}" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel x:Name="ClockTitle" Orientation="Horizontal"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Style.TextDim}" FontSize="11" Text="This view only · Notch style" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <ContentControl x:Name="StyleHost"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel x:Name="DigitalBlock">
                        <TextBlock x:Name="BigTime" Style="{StaticResource Style.Big}" FontSize="44"/>
                        <TextBlock x:Name="DateText" Style="{StaticResource Style.TextDim}" FontSize="12"/>
                        <TextBlock x:Name="ZoneText" Style="{StaticResource Style.TextDim}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="AnalogBlock" Orientation="Horizontal" Visibility="Collapsed">
                        <c:AnalogClock x:Name="Analog" Width="92" Height="92"/>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AnalogDate" Style="{StaticResource Style.Text}" FontSize="14" FontWeight="Medium"/>
                            <TextBlock x:Name="AnalogZone" Style="{StaticResource Style.TextDim}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2">
                    <Rectangle Height="1" Fill="{StaticResource Brush.Divider}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Style.TextDim}" Text="Time format" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="FormatText" Style="{StaticResource Style.Text}" FontWeight="Medium" VerticalAlignment="Center"/>
                            <TextBlock x:Name="FormatChange" Style="{StaticResource Style.Text}" Foreground="{StaticResource Brush.TextDim}"
                                       Text="Change" Margin="14,0,0,0" Cursor="Hand" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Style.TextDim}" Text="Show seconds" VerticalAlignment="Center"/>
                            <CheckBox x:Name="SecondsToggle" Style="{StaticResource Style.Toggle}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Style="{StaticResource Style.TextDim}" Text="Show date" VerticalAlignment="Center"/>
                            <CheckBox x:Name="DateToggle" Style="{StaticResource Style.Toggle}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Grid>
                    <Grid>
                        <TextBlock Style="{StaticResource Style.TextDim}" Text="Date style" VerticalAlignment="Center"/>
                        <ContentControl x:Name="DateStyleHost" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- World clocks card -->
        <Border Grid.Column="1" Style="{StaticResource Style.Card}" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel x:Name="WorldTitle" Orientation="Horizontal"/>
                    <TextBlock x:Name="AddCity" Style="{StaticResource Style.Text}" Foreground="{StaticResource Brush.Accent}"
                               FontSize="12" Text="+ Add city" HorizontalAlignment="Right" Cursor="Hand"/>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="Rows"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
