<UserControl x:Class="VAK.App.Pages.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:VAK.App.Controls">
    <UniformGrid Columns="2" Rows="2">
        <!-- Battery -->
        <Border Style="{StaticResource Style.Card}" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel x:Name="BatteryTitle" Orientation="Horizontal"/>
                    <TextBlock x:Name="BatteryHealth" Style="{StaticResource Style.TextDim}" FontSize="12" HorizontalAlignment="Right"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="BatteryPercent" Style="{StaticResource Style.Big}" FontSize="36"/>
                    <TextBlock x:Name="BatteryBolt" Style="{StaticResource Style.Icon}" FontSize="26" Margin="14,0,6,0"/>
                    <TextBlock x:Name="BatteryState" Style="{StaticResource Style.TextDim}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <Grid Grid.Row="2" Height="8">
                    <Border CornerRadius="4" Background="{DynamicResource Brush.Control}"/>
                    <Grid x:Name="BatteryBar">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="BarFill" Width="0*"/>
                            <ColumnDefinition x:Name="BarRest" Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="4" Background="{DynamicResource Brush.Accent}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Network -->
        <Border Style="{StaticResource Style.Card}" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="NetworkTitle" Orientation="Horizontal"/>
                <TextBlock x:Name="NetworkName" Grid.Row="1" Style="{StaticResource Style.Big}" FontSize="30" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NetworkSub" Grid.Row="2" Style="{StaticResource Style.TextDim}" FontSize="12"/>
                <Grid Grid.Row="3" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DownIcon" Style="{StaticResource Style.Icon}" FontSize="15" Margin="0,0,4,0"/>
                        <TextBlock x:Name="DownText" Style="{StaticResource Style.Text}" FontWeight="Medium" VerticalAlignment="Center" Width="62"/>
                        <c:Sparkline x:Name="DownSpark" Width="60" Height="22" MinScale="4096"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock x:Name="UpIcon" Style="{StaticResource Style.Icon}" FontSize="15" Margin="0,0,4,0"/>
                        <TextBlock x:Name="UpText" Style="{StaticResource Style.Text}" FontWeight="Medium" VerticalAlignment="Center" Width="62"/>
                        <c:Sparkline x:Name="UpSpark" Width="60" Height="22" MinScale="4096"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Performance -->
        <Border Style="{StaticResource Style.Card}" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="PerfTitle" Orientation="Horizontal"/>
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock x:Name="CpuText" Style="{StaticResource Style.Big}" FontSize="28"/>
                        <TextBlock Style="{StaticResource Style.TextDim}" FontSize="12" Text="CPU"/>
                        <c:Sparkline x:Name="CpuSpark" Height="28" FixedMax="100" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Rectangle Grid.Column="1" Fill="{DynamicResource Brush.Divider}"/>
                    <StackPanel Grid.Column="2" Margin="14,0,10,0">
                        <TextBlock x:Name="RamText" Style="{StaticResource Style.Big}" FontSize="28"/>
                        <TextBlock Style="{StaticResource Style.TextDim}" FontSize="12" Text="RAM"/>
                        <c:Sparkline x:Name="RamSpark" Height="28" FixedMax="100" Margin="0,8,0,0"/>
                    </StackPanel>
                    <Rectangle Grid.Column="3" Fill="{DynamicResource Brush.Divider}"/>
                    <StackPanel Grid.Column="4" Margin="14,0,0,0">
                        <TextBlock x:Name="DiskText" Style="{StaticResource Style.Big}" FontSize="28"/>
                        <TextBlock Style="{StaticResource Style.TextDim}" FontSize="12" Text="Disk"/>
                        <c:Sparkline x:Name="DiskSpark" Height="28" FixedMax="100" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Volume -->
        <Border Style="{StaticResource Style.Card}" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel x:Name="VolumeTitle" Orientation="Horizontal"/>
                    <Button x:Name="DeviceButton" Style="{StaticResource Style.RoundButton}" Width="Auto" Height="24"
                            HorizontalAlignment="Right" Padding="8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DeviceName" Style="{StaticResource Style.TextDim}" FontSize="12" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="DeviceChevron" Style="{StaticResource Style.Icon}" FontSize="12" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Grid Grid.Row="1">
                    <TextBlock x:Name="VolumePercent" Style="{StaticResource Style.Big}" FontSize="36" VerticalAlignment="Center"/>
                    <Button x:Name="MuteButton" Style="{StaticResource Style.RoundButton}" Width="48" Height="48"
                            Background="{DynamicResource Brush.Control}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="MuteIcon" Style="{StaticResource Style.Icon}" FontSize="20"/>
                    </Button>
                </Grid>
                <Slider x:Name="VolumeSlider" Grid.Row="2" Style="{StaticResource Style.Slider}"/>
            </Grid>
        </Border>
    </UniformGrid>
</UserControl>
