<UserControl x:Class="VAK.App.Shell.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,0,16,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="{StaticResource Brand.Mark}" Width="30" Height="30"/>
            <TextBlock x:Name="Title" Style="{StaticResource Style.Text}" FontSize="18" FontWeight="SemiBold"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Rectangle x:Name="Divider" Width="1" Height="22" Fill="{DynamicResource Brush.Divider}" Margin="16,0,16,0"/>
            <TextBlock x:Name="Subtitle" Style="{StaticResource Style.TextDim}" FontSize="16" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <ContentControl x:Name="Extras" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <StackPanel x:Name="BatteryChip" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="BatteryText" Style="{StaticResource Style.Text}" FontWeight="Medium" Margin="0,0,6,0"/>
                <TextBlock x:Name="BatteryIcon" Style="{StaticResource Style.Icon}" FontSize="18" Foreground="{DynamicResource Brush.Good}"/>
                <Rectangle Width="1" Height="22" Fill="{DynamicResource Brush.Divider}" Margin="16,0,10,0"/>
            </StackPanel>
            <Button x:Name="PinButton" Style="{StaticResource Style.RoundButton}" Width="34" Height="34" ToolTip="Keep open">
                <TextBlock x:Name="PinIcon" Style="{StaticResource Style.Icon}"/>
            </Button>
            <Button x:Name="SettingsButton" Style="{StaticResource Style.RoundButton}" Width="34" Height="34" ToolTip="Settings">
                <TextBlock x:Name="SettingsIcon" Style="{StaticResource Style.Icon}"/>
            </Button>
            <Button x:Name="PowerButton" Style="{StaticResource Style.RoundButton}" Width="34" Height="34" ToolTip="Turn off the notch (the shortcut brings it back)">
                <TextBlock x:Name="PowerIcon" Style="{StaticResource Style.Icon}"/>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource Style.RoundButton}" Width="34" Height="34" ToolTip="Close">
                <TextBlock x:Name="CloseIcon" Style="{StaticResource Style.Icon}"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
