<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Colors sampled from the reference screenshots -->
    <Color x:Key="Color.Panel">#000000</Color>
    <Color x:Key="Color.Card">#0D0D0F</Color>
    <Color x:Key="Color.Control">#2A2A2C</Color>
    <Color x:Key="Color.Accent">#2F7CF6</Color>
    <Color x:Key="Color.Primary">#1D64D8</Color>
    <Color x:Key="Color.Text">#FFFFFF</Color>
    <Color x:Key="Color.TextDim">#A6A6AA</Color>
    <Color x:Key="Color.TextFaint">#6E6E73</Color>
    <Color x:Key="Color.Good">#30D158</Color>

    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}"/>
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}"/>
    <SolidColorBrush x:Key="Brush.Control" Color="{StaticResource Color.Control}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}"/>
    <SolidColorBrush x:Key="Brush.TextFaint" Color="{StaticResource Color.TextFaint}"/>
    <SolidColorBrush x:Key="Brush.Good" Color="{StaticResource Color.Good}"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#1F1F22"/>

    <!-- Shape and spacing (radii are tuned against the screenshots in the visual pass) -->
    <CornerRadius x:Key="Radius.Panel">28</CornerRadius>
    <CornerRadius x:Key="Radius.Card">18</CornerRadius>
    <CornerRadius x:Key="Radius.Control">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
    <Thickness x:Key="Space.Card">16</Thickness>
    <sys:Double x:Key="Space.Gap">12</sys:Double>

    <!-- Type -->
    <FontFamily x:Key="Font.Ui">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="Font.Display">pack://application:,,,/Assets/Fonts/#Geist</FontFamily>
    <FontFamily x:Key="Font.Icons">pack://application:,,,/Assets/Icons/#FluentSystemIcons-Regular</FontFamily>
    <sys:Double x:Key="Size.Caption">11</sys:Double>
    <sys:Double x:Key="Size.Body">13</sys:Double>
    <sys:Double x:Key="Size.Title">18</sys:Double>
    <sys:Double x:Key="Size.Big">30</sys:Double>
</ResourceDictionary>
